# ===========================================
# PR Triage — Environment Variables
# ===========================================

# Database (Neon PostgreSQL)
# Get these from https://console.neon.tech
DATABASE_URL="postgresql://user:password@ep-xyz.us-east-2.aws.neon.tech/pr_triage?sslmode=require"
DIRECT_URL="postgresql://user:password@ep-xyz.us-east-2.aws.neon.tech/pr_triage?sslmode=require"

# Auth secret (generate with: openssl rand -base64 32)
AUTH_SECRET=""

# GitHub OAuth App
# Create at: https://github.com/settings/developers
# Homepage URL: https://your-domain.vercel.app
# Callback URL: https://your-domain.vercel.app/api/auth/callback/github
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""

# Encryption key for stored API keys (generate with: openssl rand -hex 32)
ENCRYPTION_KEY=""

# Server actions allowed origins (comma-separated, no protocol)
# ALLOWED_ORIGINS="your-domain.vercel.app"
